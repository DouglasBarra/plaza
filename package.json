{
  "name": "plaza",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "start": "vite build && node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js --prod",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:quiet": "taskpolicy -b playwright test",
    "test:e2e:changed": "taskpolicy -b playwright test --only-changed=main",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vite": "^6.0.7"
  }
}
